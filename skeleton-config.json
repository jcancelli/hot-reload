{
	"$schema": "https://raw.githubusercontent.com/jcancelli/hot-reload/refs/heads/master/config-schema.json",
	"server": {
		"port": 8080,
		"directory": "./out",
		"clientScriptRoute": "/hot-reload.js",
		"websocketRoute": "/hot-reload-websocket",
		"pingIntervalMs": 10000
	},
	"watcher": {
		"directories": ["./src"],
		"pollIntervalMs": 1000,
		"handlers": [
			{
				"name": "example handler",
				"command": [
					"echo",
					"absolute {{.FileAbs}} basename {{.FileBase}} directory {{.FileDir}}"
				],
				"extensions": [
					"go",
					"html",
					"js",
					"css"
				],
				"files": [
					"/home/johndoe/code/my-project/src/my-special-file.txt"
				],
				"regex": "[Hh]ello[Ww]orld",
				"printStdOut": true,
				"printStdErr": true
			}
		]
	}
}
